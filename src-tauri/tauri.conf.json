{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MIRU",
  "version": "0.1.0",
  "identifier": "app.miru.desktop",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "node scripts/build-desktop.mjs"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MIRU",
        "width": 1280,
        "height": 880,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "maximized": true,
        "fullscreen": false,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
